# Legate configuration — copy to `.env` and edit for your machine.
# `.env` is gitignored; only this example is committed.

# OpenAI-compatible endpoint of the local llama.cpp server
LEGATE_ENDPOINT=http://127.0.0.1:8080/v1

# Model alias the server advertises (must match serve.sh --alias)
LEGATE_MODEL=qwen3-coder

# Absolute path to the GGUF the server should load
LEGATE_MODEL_PATH=/path/to/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf

# llama.cpp serving knobs (RTX 3060 12GB: lower NCMOE if OOM; KV is q8_0-quantized)
LEGATE_NCMOE=30
LEGATE_PORT=8080

# Path to the llama-server binary. MUST be llama.cpp >= b10435 for Qwen3-Coder
# tool-call parsing (earlier builds drop calls that omit the <tool_call> opener).
LEGATE_LLAMA_BIN=llama-server

# Goose must run unattended (else it hangs on tool approval)
LEGATE_GOOSE_MODE=auto

# Praetor MCP server location (for `legate pentest plan`). CMD is the python that
# runs the server; ARGS/CWD launch it. Live tool execution also needs Burp + Java 21.
# LEGATE_PRAETOR_CMD=/path/to/praetor/mcp-server/.venv/bin/python
# LEGATE_PRAETOR_ARGS=-m burpsuite_mcp
# LEGATE_PRAETOR_CWD=/path/to/praetor/mcp-server

# Security work can route to a separate uncensored model so offensive/pentest
# tasks aren't refused at the weight level. Leave this unset to use the coding
# model (qwen3-coder) for everything — it's much stronger and rarely refuses
# authorized work, so it's the better default. Only enable the uncensored slot
# below if you actually hit weight-level refusals; it's a weaker fallback.
# Both models are served by name via the llama-server router (serve.sh auto-enables
# router mode when LEGATE_SECURITY_MODEL_PATH is set) and swapped one at a time on
# a single GPU.
# LEGATE_SECURITY_MODEL=gemma4-obliterated
# LEGATE_SECURITY_MODEL_PATH=/path/to/Gemma-4-12B-OBLITERATED-Q4_K_M.gguf
# LEGATE_SECURITY_ENDPOINT=   # only if you serve the security model separately
